<?xml version="1.0" encoding="UTF-8"?>
<gui width="176" height="166">
    <image x="40" y="18" width="80" height="60" basesize="256" u="40" v="18"
           src="ic2:textures/gui/guithermalcentrifuge.png"/>
    <text y="6" align="center">%name%</text>
    <slot name="input" x="10" y="17"/>
    <slot name="discharge" x="10" y="53"/>
    <slotgrid x="123" y="17" name="output" rows="3"/>
    <environment name="game">
        <slotgrid name="upgrade" x="151" y="7" cols="1"/>
        <button type="recipe" x="84" y="25" width="3" height="28" event="centrifuge"></button>
    </environment>
    <tooltip text="ic2.Centrifuge.gui.progress">
        <gauge name="progress" x="84" y="25" style="progresscentrifuge"/>
    </tooltip>
    <energygauge x="15" y="38"/>
    <text x="14" y="58">{ic2.Centrifuge.gui.heat}</text>
    <text x="14" y="69">%base.getHeat()%</text>
    <tooltip text="ic2.Centrifuge.gui.tooltipheat">
        <gauge name="heat" x="68" y="67" style="heatcentrifuge"/>
    </tooltip>
    <playerInventory x="7" y="83"/>
</gui>
